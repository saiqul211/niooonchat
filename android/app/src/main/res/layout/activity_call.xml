<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/callRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- Video Stream Containers (For Video Call Mode) -->
    <FrameLayout
        android:id="@+id/containerRemoteVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#050505"
        android:visibility="gone" />

    <!-- Local Video Preview (Picture in Picture) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardLocalVideo"
        android:layout_width="100dp"
        android:layout_height="140dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="#171717"
        app:cardCornerRadius="14dp"
        app:cardElevation="8dp">

        <FrameLayout
            android:id="@+id/containerLocalVideo"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.cardview.widget.CardView>

    <!-- Calling Info & Overlay (Audio / Video) -->
    <LinearLayout
        android:id="@+id/layoutCallInfo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="56dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <!-- Call Type Badge -->
        <TextView
            android:id="@+id/tvCallTypeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_call_btn_action"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:text="NIOOON VOICE CALL"
            android:textColor="#9CA3AF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- User Avatar Circle -->
        <FrameLayout
            android:id="@+id/layoutAvatarContainer"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="48dp">

            <View
                android:id="@+id/avatarGlowRing"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_call_avatar_glow" />

            <TextView
                android:id="@+id/tvAvatarInitials"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="NC"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- User Name -->
        <TextView
            android:id="@+id/tvCallerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Username"
            android:textColor="#F3F4F6"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- User Username -->
        <TextView
            android:id="@+id/tvCallerUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@username"
            android:textColor="#9CA3AF"
            android:textSize="13sp" />

        <!-- Call Status / Timer -->
        <TextView
            android:id="@+id/tvCallStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Calling..."
            android:textColor="#60A5FA"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Active Call Controls (Mute, Speaker, Video Toggle, Camera Flip) -->
        <LinearLayout
            android:id="@+id/layoutActiveControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="visible">

            <!-- Mic Mute Button -->
            <ImageButton
                android:id="@+id/btnMute"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_call_btn_action"
                android:contentDescription="Mute Microphone"
                android:src="@drawable/ic_mic_on" />

            <!-- Speakerphone Button -->
            <ImageButton
                android:id="@+id/btnSpeaker"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_call_btn_action"
                android:contentDescription="Toggle Speakerphone"
                android:src="@drawable/ic_speaker_on" />

            <!-- Video Camera Toggle Button -->
            <ImageButton
                android:id="@+id/btnToggleVideo"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_call_btn_action"
                android:contentDescription="Toggle Video Camera"
                android:src="@drawable/ic_video_on" />

            <!-- Camera Switch Button -->
            <ImageButton
                android:id="@+id/btnSwitchCamera"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_call_btn_action"
                android:contentDescription="Switch Camera"
                android:src="@drawable/ic_camera_switch"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Outgoing & In-Call End Call Button -->
        <FrameLayout
            android:id="@+id/layoutEndCall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:visibility="visible">

            <ImageButton
                android:id="@+id/btnEndCall"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_call_btn_end"
                android:contentDescription="End Call"
                android:src="@drawable/ic_call_end" />
        </FrameLayout>

        <!-- Incoming Call Action Buttons (Accept / Reject) -->
        <LinearLayout
            android:id="@+id/layoutIncomingActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- Reject Call -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="48dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnRejectIncoming"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_call_btn_end"
                    android:contentDescription="Reject Call"
                    android:src="@drawable/ic_call_end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Decline"
                    android:textColor="#EF4444"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Accept Call -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnAcceptIncoming"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_call_btn_accept"
                    android:contentDescription="Accept Call"
                    android:src="@drawable/ic_call_accept" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Accept"
                    android:textColor="#22C55E"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
